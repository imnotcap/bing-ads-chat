{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window. HTTP is limited to Microsoft Advertising, Microsoft sign-in and report downloads; Claude is reached with the webview's own fetch (allowed by the CSP). The window is frameless; the custom title bar may minimize, maximize, close and drag it.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-is-maximized",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-minimize",
    "core:window:allow-set-decorations",
    "allow-secret-get",
    "allow-secret-set",
    "allow-secret-delete",
    "allow-oauth-listen",
    "allow-oauth-token",
    "allow-export-save",
    "allow-export-open-folder",
    "allow-set-close-to-tray",
    "allow-quit-app",
    "allow-check-for-update",
    "allow-install-update",
    "allow-open-download-page",
    "opener:default",
    "notification:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://*.api.bingads.microsoft.com/*"
        },
        {
          "url": "https://*.api.sandbox.bingads.microsoft.com/*"
        },
        {
          "url": "https://login.microsoftonline.com/*"
        },
        {
          "url": "https://*.blob.core.windows.net/*"
        }
      ]
    }
  ]
}
