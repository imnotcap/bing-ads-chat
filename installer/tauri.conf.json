{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bing Ads Chat Setup",
  "version": "1.0.0",
  "identifier": "dk.bingadschat.setup",
  "build": {
    "frontendDist": "./ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Installér Bing Ads Chat",
        "width": 700,
        "height": 470,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "center": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
